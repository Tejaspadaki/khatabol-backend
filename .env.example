# Groq (LLM): https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_FORMAT=
LLM_REASONING_EFFORT=low
# Alternative: openai/gpt-oss-120b (set LLM_REASONING_FORMAT= and LLM_REASONING_EFFORT=low)

# Sarvam AI (speech-to-text + text-to-speech): https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# translit = Roman-script Hinglish output; leave empty with saaras:v4 for native script
SARVAM_STT_MODE=translit
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# SQLite by default (zero setup). For Postgres:
# DATABASE_URL=postgresql+asyncpg://khata:khata@localhost:5432/khata
DATABASE_URL=sqlite+aiosqlite:///./khata.db

# Morning reminders / evening summary / nightly balance check (IST hours)
ENABLE_SCHEDULER=false
REMINDER_HOUR=9
SUMMARY_HOUR=21

# LLM: Gemma 4 (OpenAI-compatible endpoint). Set LLM_PROVIDER=groq to use Groq instead.
LLM_PROVIDER=gemma4
GEMMA4_BASE_URL=https://llm-chat.markytics.com/v1
GEMMA4_API_KEY=
GEMMA4_MODEL=google/gemma-4-E4B-it
